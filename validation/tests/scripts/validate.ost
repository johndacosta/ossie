#
# Validation cases for validate(model). Each case is a model and the
# diagnostics that validate.py reports for it.

# A minimal model is valid.
validate({|version: "0.2.0.dev0"
name: m
datasets:
  - name: orders
    source: shop.orders
    fields:
      - name: id
        expression:
          dialects:
            - dialect: ANSI_SQL
              expression: id
|});
> "valid" : string

# Two datasets with the same name.
validate({|version: "0.2.0.dev0"
name: m
datasets:
  - name: orders
    source: shop.orders
  - name: orders
    source: shop.orders_v2
|});
> "error: [Unique] Duplicate dataset name 'orders' in model 'm'" : string

# A key the schema does not define.
validate({|version: "0.2.0.dev0"
name: m
datasets:
  - name: orders
    source: shop.orders
    colour: red
|});
> "error: [Schema] datasets -> 0: Additional properties are not allowed ('colour' was unexpected)" : string

# When the schema check fails, the deeper checks do not run, so the
# duplicate name below is not reported.
validate({|version: "0.2.0.dev0"
name: m
datasets:
  - name: orders
    source: shop.orders
    colour: red
  - name: orders
    source: shop.orders
|});
> "error: [Schema] datasets -> 0: Additional properties are not allowed ('colour' was unexpected)" : string

# A YAML key that appears twice.
validate({|version: "0.2.0.dev0"
name: m
name: n
|});
> error: while constructing a mapping

# End validate.ost
